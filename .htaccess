Options -MultiViews
RewriteEngine On
RewriteBase /bookingjaunt/

# Fix double bookingjaunt path caused by cached redirects
RewriteCond %{REQUEST_URI} ^/bookingjaunt/bookingjaunt/(.*)$
RewriteRule ^bookingjaunt/(.*)$ /bookingjaunt/$1 [R=302,L]

# Add trailing slash for directories
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.*[^/])$ $1/ [R=302,L]

# Rewrite clean URLs to .php (this fixes the 404s for extensionless links)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L,QSA]